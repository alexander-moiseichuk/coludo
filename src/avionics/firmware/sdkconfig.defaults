# Coludo avionics -- ESP-IDF v5.5.5 configuration for the WaveShare ESP32-P4-WIFI6 (ESP32-P4 + ESP32-C6).

# Silicon: the fleet's P4 is revision v1.3. IDF 5.5 defaults to v3.x, which is NOT compatible with v0.x/v1.x,
# so select the pre-3 line. v1.0 as the floor drops the v0.x workarounds; the max is then v1.99.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
# 360 MHz is the ceiling for rev < 3 (400 MHz only on chips Espressif qualified)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# Flash: the part is a 32 MB GigaDevice (0xc8 0x4019, GD25Q256-class): declared in full. Above 16 MB IDF uses
# 4-byte addressing through esp_flash (data only -- cache-mapping that range is experimental and never needed:
# the code runs from PSRAM and the telemetry ring is read with esp_flash_read, never mmap).
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# PSRAM (32 MB hex, on its own bus from the flash): on, in the heap for large allocations
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
# the boot-time PSRAM test costs 0.9 s of every boot (and of every warm start)
CONFIG_SPIRAM_MEMTEST=n
# Execute from PSRAM (the image is copied there at boot): flash erase/program then no longer freezes the caches,
# because the P4's flash and PSRAM sit on separate buses -- the telemetry ring in flash depends on it (B4: a 1 kHz
# loop kept max 19 us lateness, 0 missed, while the other core erased and programmed). Also a little faster than
# flash XIP (control step -5%, pacing max 41 -> 19 us). Costs ~0.75 MB of PSRAM and ~10 KB internal RAM.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# FreeRTOS: a 1 ms tick so sleeps and timeouts resolve at 1 ms, not 10
CONFIG_FREERTOS_HZ=1000
# Rust std main needs more than the C default
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8192

# A panic prints its backtrace and reboots -- a wedged board must come back on its own
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# Console on UART0 (the board's CH343P USB-serial port)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Wi-Fi through the ESP32-C6 over SDIO (esp_hosted + esp_wifi_remote), as MicroPython v1.29.0 configures it
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
# esp_hosted's own debug CLI would register commands next to our console
CONFIG_ESP_HOSTED_CLI_ENABLED=n
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y

# FatFs on the microSD: long file names (session files like 000135_flight.csv); FatFs defaults to 8.3 only
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
